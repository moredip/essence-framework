{
  "name": "essence-framework",
  "version": "0.1.0",
  "description": "A minimalist web framework for zero-boilerplate APIs and HTML sites",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "essence-framework": "dist/cli.js"
  },
  "scripts": {
    "test": "jest --runInBand",
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write ."
  },
  "devDependencies": {
    "@types/chokidar": "^1.7.5",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.1.8",
    "jest": "^29.5.0",
    "jest-extended": "^6.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "jest-extended/all"
    ]
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "h3": "^1.15.3",
    "ink": "^6.0.1",
    "jiti": "^2.4.0",
    "nano-jsx": "^0.1.0",
    "react": "^19.1.0"
  }
}
